{
  "version": 1,
  "author": "Gas & Fire Safety Alert",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-gas-sensor", "id": "gas1", "top": 20, "left": -200, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht1", "top": -20, "left": 200, "attrs": {} },
    { "type": "wokwi-buzzer", "id": "bz1", "top": -110, "left": 20, "attrs": { "volume": "0.1" } },
    { "type": "wokwi-led", "id": "led1", "top": 230, "left": -60, "attrs": { "color": "red" } },
    { "type": "wokwi-led", "id": "led2", "top": 230, "left": 60, "attrs": { "color": "green" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 190, "left": -100, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 190, "left": 20, "rotate": 90, "attrs": { "value": "220" } }
  ],
  "connections": [
    ["esp:TX0", "$serialMonitor:RX", "", []],
    ["esp:RX0", "$serialMonitor:TX", "", []],
    ["gas1:VCC", "esp:3V3", "red", []],
    ["gas1:GND", "esp:GND.1", "black", []],
    ["gas1:AOUT", "esp:D34", "green", []],
    ["dht1:VCC", "esp:3V3", "red", []],
    ["dht1:GND", "esp:GND.1", "black", []],
    ["dht1:SDA", "esp:D15", "green", []],
    ["bz1:1", "esp:D25", "green", []],
    ["bz1:2", "esp:GND.1", "black", []],
    ["esp:D26", "r1:1", "green", []],
    ["r1:2", "led1:A", "green", []],
    ["led1:C", "esp:GND.1", "black", []],
    ["esp:D33", "r2:1", "green", []],
    ["r2:2", "led2:A", "green", []],
    ["led2:C", "esp:GND.1", "black", []]
  ],
  "dependencies": {}
}
